generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ORDER — nguyên tắc xương sống: ĐƠN HÀNG LÀ SNAPSHOT.
// Giá/tên/option được ĐÓNG BĂNG tại thời điểm đặt (copy giá trị), chỉ giữ id
// gốc để tham chiếu/analytics. Product đổi giá, đổi tên, xoá option — đơn cũ
// KHÔNG được đổi theo (khác giỏ hàng: giỏ tham chiếu id + hydrate lại).
// Cross-service id (productId, customerId...) = string thường, KHÔNG FK.
// KHÔNG bao giờ xoá đơn — vòng đời quản bằng status (xem docs/patterns/soft-delete.md).
// ============================================================================

enum OrderStatus {
  PENDING // vừa đặt, chờ shop xác nhận
  CONFIRMED // shop đã xác nhận, đang chuẩn bị
  SHIPPING // đã giao cho vận chuyển
  COMPLETED // giao thành công — terminal
  CANCELLED // huỷ (khách huỷ / shop huỷ / giao thất bại) — terminal
  // Máy trạng thái (service gác, DB không biết):
  //   PENDING   → CONFIRMED | CANCELLED
  //   CONFIRMED → SHIPPING  | CANCELLED
  //   SHIPPING  → COMPLETED | CANCELLED (giao thất bại)
  //   COMPLETED / CANCELLED → hết đường (terminal)
}

model Order {
  id     String      @id @default(uuid())
  code   String      @unique // mã human-readable: ORD-260812-A1B2 (service tự sinh)
  status OrderStatus @default(PENDING)

  // Khách đặt — Phase 0 nhận từ payload (CHƯA tin được vì gateway chưa verify JWT);
  // Phase 1 lấy từ token. null = khách vãng lai.
  customerId String?

  // Snapshot thông tin nhận hàng (khách đổi profile sau này không ảnh hưởng đơn cũ)
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String?
  note            String?

  // Tiền — snapshot toàn bộ
  // GIÁ DO SERVER TỰ TÍNH từ product-service — không bao giờ nhận giá từ FE.
  subtotal       Decimal @db.Decimal(12, 2) // tổng lineTotal các item
  shippingFee    Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2) // promotion (làm sau) — để sẵn cột
  total          Decimal @db.Decimal(12, 2) // subtotal + shippingFee - discountAmount

  promotionId   String? // campaign đã áp (promotion-service, sau)
  paymentMethod String  @default("COD") // Phase 2 mới có payment-service thật

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems         OrderItem[]
  orderStatusHistory OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Tham chiếu về product-service (analytics/đối soát) — không FK, không dùng để hiển thị
  productId String
  variantId String?
  sku       String

  // SNAPSHOT hiển thị — nguồn sự thật của hoá đơn
  productName String
  variantName String? // "Đỏ / S" — ghép từ attribute values lúc đặt
  imageUrl    String?
  unitPrice   Decimal @db.Decimal(12, 2) // giá 1 đơn vị = giá gốc/sale + tổng extraPrice option
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2) // unitPrice * quantity

  // Quà khuyến mãi: line bình thường với unitPrice = 0 (kho vẫn trừ đủ — chốt 2026-08-12)
  isGift      Boolean @default(false)
  promotionId String?

  createdAt DateTime @default(now())

  orderItemOptions OrderItemOption[]

  @@index([orderId])
  @@index([productId])
}

// Option khách đã chọn cho 1 line — snapshot tên + giá, giữ id gốc để tham chiếu
model OrderItemOption {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  optionItemId String // id ProductOptionItem gốc (tham chiếu — có thể đã bị xoá sau này, không sao)
  groupName    String // "Topping"
  itemName     String // "Trân châu đường đen"
  extraPrice   Decimal @default(0) @db.Decimal(12, 2)

  @@index([orderItemId])
}

// Sổ cái trạng thái — append-only (ledger thứ 4 của dự án 😄).
// Trả lời "đơn này đi qua những trạng thái nào, lúc nào, vì sao" —
// lý do huỷ/ghi chú giao hàng nằm ở note, KHÔNG có cột cancelReason riêng.
model OrderStatusHistory {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus? // null = dòng khởi tạo đơn (→ PENDING)
  toStatus   OrderStatus
  note       String? // "khách gọi huỷ", "giao thất bại lần 2"...

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}
