// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  imageUrl    String?
  status      Boolean   @default(true)
  priority    Int       @default(0)
  description String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?

  parentId String?
  parent   Category?  @relation("CategoryParentChild", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryParentChild")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([parentId, status])
}

model Label {
  id     String  @id @default(uuid())
  name   String
  color  String?
  status Boolean @default(true)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  productLabels ProductLabel[]
}

model Brand {
  id          String  @id @default(uuid())
  name        String
  logo        String?
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model ProductLabel {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([productId, labelId])
}

// Phân loại sản phẩm — quyết định mô hình kho:
// SIMPLE = 1 SKU, không option/variant · OPTION = option groups (chỉ +extraPrice,
// vẫn 1 SKU) · VARIANT = nhiều SKU, mỗi biến thể 1 tồn kho riêng.
// Invariant (service tự gác, DB không biết): OPTION không có variant & ngược lại.
enum ProductType {
  SIMPLE
  OPTION
  VARIANT
}

model Product {
  id               String      @id @default(uuid())
  name             String
  slug             String      @unique
  type             ProductType @default(SIMPLE)
  thumbnail        String?
  images           String[]
  enablePrice      Boolean     @default(true)
  price          Decimal   @default(0) @db.Decimal(12, 2)
  compareAtPrice Decimal?  @db.Decimal(12, 2)
  saleStartAt    DateTime?
  saleEndAt      DateTime?
  sku              String      @unique
  description      String?
  shortDescription String?
  status           Boolean     @default(true)
  priority         Int         @default(0)
  isDeleted        Boolean     @default(false)
  deletedAt        DateTime?
  unit             String?
  weight           Decimal?
  weightUnit       String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  productLabels       ProductLabel[]
  productOptionGroups ProductOptionGroup[]
  productAttributes   ProductAttribute[]
  productVariants     ProductVariant[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([status, priority])
}

model ProductOptionGroup {
  id        String @id @default(uuid())
  name      String
  minSelect Int    @default(0)
  maxSelect Int?
  position  Int    @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  productOptionItems ProductOptionItem[]

  @@index([productId])
}

model ProductOptionItem {
  id         String  @id @default(uuid())
  name       String
  extraPrice Decimal @default(0) @db.Decimal(12, 2)
  status     Boolean @default(true)
  isDefault  Boolean @default(false) // được tick sẵn khi khách mở sản phẩm
  position   Int     @default(0)

  productOptionGroupId String
  productOptionGroup   ProductOptionGroup @relation(fields: [productOptionGroupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productOptionGroupId])
}

// Thư viện MẪU option dùng chung — KHÔNG gắn productId.
// "Áp mẫu" = COPY (snapshot) sang ProductOptionGroup/Item của từng sản phẩm;
// sau khi copy thì độc lập, sửa sản phẩm không ảnh hưởng mẫu và ngược lại.
model OptionTemplate {
  id        String @id @default(uuid())
  name      String @unique
  minSelect Int    @default(0) // số item tối thiểu khách phải chọn (0 = optional; >=1 = required)
  maxSelect Int? // số item tối đa được chọn (null = không giới hạn; 1 = single-select)
  position  Int    @default(0)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  optionTemplateItems OptionTemplateItem[]
}

model OptionTemplateItem {
  id         String  @id @default(uuid())
  name       String
  extraPrice Decimal @default(0) @db.Decimal(12, 2)
  isDefault  Boolean @default(false) // được tick sẵn khi khách mở sản phẩm
  position   Int     @default(0)

  optionTemplateId String
  optionTemplate   OptionTemplate @relation(fields: [optionTemplateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([optionTemplateId])
}

model ProductAttribute {
  id       String @id @default(uuid())
  name     String
  position Int    @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  productAttributeValues ProductAttributeValue[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductAttributeValue {
  id       String @id @default(uuid())
  value    String
  position Int    @default(0)

  productAttributeId String
  productAttribute   ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  productVariantAttributeValues ProductVariantAttributeValue[]

  @@index([productAttributeId, value])
  @@index([productAttributeId])
}

model ProductVariant {
  id        String    @id @default(uuid())
  sku       String    @unique
  price          Decimal   @default(0) @db.Decimal(12, 2)
  compareAtPrice Decimal?  @db.Decimal(12, 2)
  saleStartAt    DateTime?
  saleEndAt      DateTime?
  stock     Int       @default(0)
  imageUrl  String?
  status    Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  productVariantAttributeValues ProductVariantAttributeValue[]

  @@index([productId])
}

model ProductVariantAttributeValue {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  productAttributeValueId String
  productAttributeValue   ProductAttributeValue @relation(fields: [productAttributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, productAttributeValueId])
}
