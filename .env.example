# ============================================================================
#  TEMPLATE env dùng chung cho toàn monorepo — COPY thành `.env` rồi điền giá trị.
#    cp .env.example .env
#  File này ĐƯỢC commit (không chứa secret thật); `.env` thì KHÔNG (gitignore).
#  DATABASE_URL của từng service nằm ở apps/<service>/.env.example.
# ============================================================================

# --- Logging ---
LOG_LEVEL=debug

# --- Bảo mật nội bộ ---
# Shared secret chứng thực service-to-service (AMQP header `x-internal-token`).
# MỌI app phải cùng giá trị. Sinh chuỗi ngẫu nhiên: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=
# Origin FE được phép gọi API, phân tách bằng dấu phẩy. Bỏ trống = cho phép tất cả (CHỈ dev).
CORS_ORIGINS=http://localhost:3000

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RMQ_AUTH_QUEUE=auth_queue
RMQ_PRODUCT_QUEUE=product_queue
RMQ_ORDER_QUEUE=order_queue
RMQ_INVENTORY_QUEUE=inventory_queue
RMQ_NOTIFICATION_QUEUE=notification_queue

# --- JWT (auth-service KÝ, gateway VERIFY — phải cùng JWT_SECRET) ---
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=900
# Secret RIÊNG cho refresh token (KHÔNG dùng lại JWT_SECRET)
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=604800

# --- Redis (OTP + refresh token) ---
REDIS_URL=redis://localhost:6380

# --- OTP ---
OTP_TTL=300
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5

# --- MinIO / S3 (upload ảnh) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MEDIA_BUCKET=omial-media
MEDIA_PUBLIC_URL=http://localhost:9000

# --- SMTP (gửi OTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail: dùng App Password 16 ký tự, KHÔNG dùng mật khẩu tài khoản
SMTP_PASS=
MAIL_FROM=Omial Market <no-reply@omial.dev>
